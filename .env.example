# Copy to .env if you want the live model. Never commit a real key.
# When OPENAI_API_KEY is empty or unset, the server uses deterministic mock replies.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server port. The Vite dev server proxies /api to this port.
PORT=8787

# Token-overlap score below which a question is handed to a person.
HANDOFF_CONFIDENCE=0.34

# Pause between mock stream chunks, in milliseconds. Use 0 in tests.
MOCK_STREAM_DELAY_MS=22
